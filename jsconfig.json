{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./src/app/*"],
      "@providers/*": ["./src/lib/providers/*"],
      "@features/*": ["./src/features/*"],
      "@config/*": ["./src/shared/config/*"],
      "@lib/*": ["./src/lib/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@components/*": ["./src/features/components/*"],
      "@animations/*": ["./src/features/animations/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "src/**/*",
    "next.config.mjs",
    "env.mjs"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "__MACOSX",
    "public"
  ]
}
